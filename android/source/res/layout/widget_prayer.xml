<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_normal"
    android:padding="16dp">

    <!-- decorative mosque silhouette, bottom-anchored like a mascot -->
    <ImageView
        android:layout_width="180dp"
        android:layout_height="108dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-18dp"
        android:layout_marginBottom="-8dp"
        android:scaleType="fitEnd"
        android:src="@drawable/ic_mosque_silhouette" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_crescent" />

            <TextView
                android:id="@+id/tv_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gold_light"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="🕌 العصر" />
        </LinearLayout>

        <Chronometer
            android:id="@+id/chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/cream"
            android:textSize="44sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:id="@+id/tv_static_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/cream"
            android:textSize="44sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:text="—:—" />

        <TextView
            android:id="@+id/tv_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/white_90"
            android:textSize="11sp"
            android:text="" />
    </LinearLayout>

</FrameLayout>
